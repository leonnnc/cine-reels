# Credenciales de la app de Meta (NUNCA se envían al navegador).
# Crea la app en https://developers.facebook.com/apps/ y copia aquí sus datos.
FB_APP_ID=
FB_APP_SECRET=

# Versión de Graph API usada para oEmbed.
FB_GRAPH_VERSION=v23.0

# Puerto del servidor local.
PORT=8080

# Origen permitido para el proxy (vacío = mismo origen).
ALLOW_ORIGIN=
